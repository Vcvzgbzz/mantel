{
  "name": "@vcvzgbzz/mantel",
  "version": "0.1.0",
  "description": "A self-hosted memory service for agents: every memory knows where it came from, and nothing is silently overwritten.",
  "type": "module",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Vcvzgbzz/mantel.git"
  },
  "bugs": {
    "url": "https://github.com/Vcvzgbzz/mantel/issues"
  },
  "homepage": "https://github.com/Vcvzgbzz/mantel#readme",
  "keywords": [
    "llm",
    "agent",
    "memory",
    "rag",
    "provenance",
    "openai-compatible",
    "sqlite"
  ],
  "engines": {
    "node": ">=22.13"
  },
  "bin": {
    "mantel": "dist/cli.js"
  },
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "files": [
    "dist",
    "README.md"
  ],
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./package.json": "./package.json"
  },
  "scripts": {
    "build": "tsc",
    "prepare": "tsc",
    "prepublishOnly": "npm run typecheck && npm test && npm run build",
    "typecheck": "tsc -p tsconfig.test.json",
    "dev": "tsx src/cli.ts serve",
    "test": "tsx --test test/*.test.ts"
  },
  "dependencies": {
    "yaml": "^2.5.0"
  },
  "devDependencies": {
    "@types/node": "^22.20.1",
    "tsx": "^4.19.0",
    "typescript": "^5.6.0"
  }
}
